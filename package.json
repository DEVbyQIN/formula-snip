{
  "name": "formula-snip",
  "version": "1.0.0",
  "private": true,
  "description": "LaTeX-suite style snippets to transparent PNG formulas, as a standalone macOS app",
  "scripts": {
    "vendor": "scripts/prepare-vendor.sh app/web/vendor",
    "build": "scripts/build-app.sh",
    "dist": "scripts/make-dmg.sh",
    "test:web": "node scripts/web-selftest.mjs",
    "test:native": "dist/FormulaSnip.app/Contents/MacOS/FormulaSnip --selftest /tmp/formulasnip-selftest",
    "test": "npm run test:web"
  },
  "keywords": [
    "latex",
    "mathjax",
    "snippets",
    "transparent-png",
    "macos"
  ],
  "author": "QIN-SMART",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@mathjax/mathjax-fira-font": "4.1.3",
    "@mathjax/mathjax-modern-font": "4.1.3",
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "@mathjax/mathjax-pagella-font": "4.1.3",
    "@mathjax/mathjax-stix2-font": "4.1.3",
    "@mathjax/mathjax-tex-font": "4.1.3",
    "mathjax": "4.1.3"
  }
}
