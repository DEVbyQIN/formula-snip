{
  "name": "formula-snip",
  "version": "1.0.0",
  "private": true,
  "description": "LaTeX-suite style snippets to transparent PNG formulas, as a standalone macOS / Windows desktop app",
  "main": "electron/main.js",
  "scripts": {
    "vendor": "scripts/prepare-vendor.sh app/web/vendor",
    "build": "scripts/build-app.sh",
    "dist": "scripts/make-dmg.sh",
    "electron": "electron .",
    "electron:selftest": "electron . --selftest /tmp/formulasnip-electron-selftest",
    "electron:pack": "electron-builder --mac dir",
    "electron:dmg": "scripts/build-electron.sh",
    "electron:win": "electron-builder --win nsis",
    "test:web": "node scripts/web-selftest.mjs",
    "test:native": "dist/FormulaSnip.app/Contents/MacOS/FormulaSnip --selftest /tmp/formulasnip-selftest",
    "test:electron": "electron . --selftest /tmp/formulasnip-electron-selftest",
    "test": "npm run test:web"
  },
  "keywords": [
    "latex",
    "mathjax",
    "snippets",
    "transparent-png",
    "macos",
    "windows",
    "electron"
  ],
  "author": "QIN-SMART",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {},
  "devDependencies": {
    "@mathjax/mathjax-fira-font": "4.1.3",
    "@mathjax/mathjax-modern-font": "4.1.3",
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "@mathjax/mathjax-pagella-font": "4.1.3",
    "@mathjax/mathjax-stix2-font": "4.1.3",
    "@mathjax/mathjax-tex-font": "4.1.3",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "mathjax": "4.1.3"
  },
  "build": {
    "appId": "com.qin.formulasnip.electron",
    "productName": "FormulaSnip",
    "directories": {
      "output": "dist-electron",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "app/web",
        "to": "web"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/AppIcon.icns",
      "identity": null
    },
    "dmg": {
      "artifactName": "FormulaSnip-${version}-electron.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/AppIcon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "FormulaSnip-Setup-${version}.${ext}"
    }
  }
}
